$ curl -i http://127.0.0.1:3000/ping
HTTP/1.1 200 OK
content-type: text/plain; charset=utf-8
content-length: 4

pong

$ curl -i -X POST http://127.0.0.1:3000/ping
HTTP/1.1 200 OK
content-type: text/plain; charset=utf-8
content-length: 4

pong

$ curl -i -X DELETE http://127.0.0.1:3000/ping
HTTP/1.1 200 OK
content-type: text/plain; charset=utf-8
content-length: 4

pong

$ curl -i -X PATCH http://127.0.0.1:3000/ping
HTTP/1.1 200 OK
content-type: text/plain; charset=utf-8
content-length: 4

pong
