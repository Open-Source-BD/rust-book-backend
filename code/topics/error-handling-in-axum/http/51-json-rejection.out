$ curl -i http://127.0.0.1:3000/books/abc
HTTP/1.1 400 Bad Request
content-type: application/json
content-length: 54

{"error":"Invalid URL: Cannot parse `abc` to a `u32`"}

$ curl -i -X POST http://127.0.0.1:3000/books -H 'content-type: application/json' -d '{"title":"Emma"'
HTTP/1.1 400 Bad Request
content-type: application/json
content-length: 101

{"error":"Failed to parse the request body as JSON: EOF while parsing an object at line 1 column 15"}

$ curl -i -X POST http://127.0.0.1:3000/books -H 'content-type: application/json' -d '{}'
HTTP/1.1 422 Unprocessable Entity
content-type: application/json
content-length: 110

{"error":"Failed to deserialize the JSON body into the target type: missing field `title` at line 1 column 2"}

$ curl -i -X POST http://127.0.0.1:3000/books -d '{"title":"Hamlet"}'
HTTP/1.1 415 Unsupported Media Type
content-type: application/json
content-length: 66

{"error":"Expected request with `Content-Type: application/json`"}

$ curl -i -X POST http://127.0.0.1:3000/books -H 'content-type: application/json' -d '{"title":"Hamlet"}'
HTTP/1.1 201 Created
content-type: application/json
content-length: 25

{"id":3,"title":"Hamlet"}
